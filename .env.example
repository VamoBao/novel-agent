# 环境变量配置示例：复制为 .env 并填入真实值（.env 已被 gitignore 排除）。
# 模型配置亦可在客户端「⚙️ 设置」弹窗配置（userData/settings.json 明文存储，
# 优先级高于本文件：设置 > .env > 继承环境变量；未在本文件配置的字段可只走客户端）

# Agent 模型（世界观 / 角色 / 大纲 / 章节规划 / 正文校验）
# 接口类型（可选：openai / deepseek / claude——决定调用哪家官方 SDK 与协议）
# 留空按有效地址迁移：DeepSeek 官方地址用 DeepSeek，其余地址用 OpenAI；
# 填了非法值启动即报错，不会静默换协议
AGENT_MODEL_PROVIDER=
# API Key（必填；兼容旧 DEEPSEEK_API_KEY）
AGENT_MODEL_API_KEY=
# 模型名（可选；DeepSeek 留空默认 deepseek-flash，openai / claude 无默认值需填写；兼容旧 DEEPSEEK_MODEL_NAME）
AGENT_MODEL_NAME=
# 接口 Base URL（可选，留空按接口类型取官方默认地址：openai https://api.openai.com/v1、
# deepseek https://api.deepseek.com、claude https://api.anthropic.com/v1）
# 接入其他服务时同时填写对应模型名与地址，如 https://api.example.com/v1（自定义地址须支持所选协议）
AGENT_MODEL_BASE_URL=

# 写作模型（可选；小说正文创作时使用，可与上面的 Agent 模型不同。
# 三项需同时配置才启用独立写作模型；任一未配置时回落 Agent 会话模型）
# 接口类型（可选：openai / deepseek / claude；留空按有效地址迁移，独立写作默认 OpenAI）
WRITING_MODEL_PROVIDER=
# 模型名（按所接服务填写，如 gpt-5.2 / qwen3-max）
WRITING_MODEL_NAME=
# API Key
WRITING_MODEL_API_KEY=
# 接口 Base URL（如 https://api.example.com/v1；自定义地址须支持所选协议）
WRITING_MODEL_BASE_URL=

# SQLite 数据库路径（可选，默认 data/novel.db；打包客户端固定注入 userData 标准数据目录，此处仅开发期 CLI 生效）
NOVEL_DB_PATH=

# 章节正文产物输出根目录（可选，默认 output/——正文按 <小说ID>/<部名>/<章名>.md 分文件夹存放；
# 打包客户端优先级：设置弹窗「产物输出目录」> 本文件 > 继承环境变量 > userData/output）
NOVEL_OUTPUT_DIR=

# 写作偏好系统级默认（可选；客户端「⚙️ 设置 → 写作偏好（默认）」维护并注入，优先级同上：
# 设置 > .env > 继承环境变量。未配置时正文生成用内置默认——篇幅 2000~3000 字、文风合格线 80；
# 单本小说可在客户端书库右键「📏 写作偏好」单独覆盖，优先级高于此处）
# 章节篇幅下限（字，100~100000 整数）
NOVEL_CHAPTER_LENGTH_MIN=
# 章节篇幅上限（字，100~100000 整数，须与下限同时设置且不小于下限）
NOVEL_CHAPTER_LENGTH_MAX=
# 文风相似度合格线（0-100 整数）
NOVEL_STYLE_PASS_SCORE=
