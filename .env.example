# 环境变量配置示例：复制为 .env 并填入真实值（.env 已被 gitignore 排除）

# DeepSeek API Key（必填）
DEEPSEEK_API_KEY=

# 模型名（可选，默认 deepseek-flash；如 deepseek-v4-flash / deepseek-v4-pro）
DEEPSEEK_MODEL_NAME=

# 写作模型（可选，OpenAI 接口兼容端点；小说正文创作时使用，可与上面的 Agent 模型不同。
# 三项需同时配置才启用独立写作模型；任一未配置时回落 Agent 会话模型（DeepSeek））
# 模型名（按所接服务填写，如 gpt-5.2 / qwen3-max）
WRITING_MODEL_NAME=
# API Key
WRITING_MODEL_API_KEY=
# 接口 Base URL（如 https://api.example.com/v1）
WRITING_MODEL_BASE_URL=

# SQLite 数据库路径（可选，默认 data/novel.db）
NOVEL_DB_PATH=
